# ---- Runtime paths (shared source of truth across processes) ----
# In Docker this is a shared volume; locally it defaults to ./_runtime.
AEVP_RUNTIME=./_runtime

# ---- Sinkhole (Tier 0 egress destination) ----
AEVP_SINK_HOST=127.0.0.1
AEVP_SINK_PORT=8080
# The egress-capable tool posts exfil here. In compose this is the service URL.
AEVP_SINK_URL=http://127.0.0.1:8080

# ---- Range injection control (set by the runner, not by hand) ----
# AEVP_INJECT names the attack case whose payload the range presents; empty is a
# CLEAN range. AEVP_CANARY is the per-trial token embedded in that payload.
# The benign twin runs the same task with AEVP_INJECT empty -- that is what makes
# a silent oracle a real negative control.
AEVP_INJECT=
AEVP_CANARY=
# 1 = get_shipping_policy presents a mutated description (rug-pull); drives P5.
AEVP_RUGPULL=0

# ---- Live model provider (turns the harness into a real measurement) ----
# Pick an endpoint with --preset {openrouter,groq,cerebras}; set the matching key.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# AI Hub (Anthropic /v1/messages gateway); key looks like sk-hub-...
AIHUB_API_KEY=
# Optional overrides (preset supplies sensible defaults):
# AEVP_MODEL=openai/gpt-oss-120b
# AEVP_BASE_URL=https://api.groq.com/openai/v1

# ---- Offline validation only (fake model server) ----
# Probability the fake model complies with an injection; used by
# tests/validate_live_path.py to produce non-degenerate ASR without network.
AEVP_FAKE_COMPLY=0.5
AEVP_FAKE_PORT=8099
